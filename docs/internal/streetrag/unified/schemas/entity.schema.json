{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urbancode.dev/schemas/entity.schema.json",
  "title": "UrbanPackage entity (draft stub)",
  "description": "Place, Street, or Region. IDs are minted by UrbanCode. Documentation only.",
  "type": "object",
  "additionalProperties": true,
  "required": ["entity_id", "entity_level", "city_id"],
  "properties": {
    "entity_id": { "type": "string" },
    "entity_level": { "type": "string", "enum": ["place", "street", "region"] },
    "city_id": { "type": "string" },
    "source": { "type": "string" },
    "geometry_ref": { "type": "string" },
    "layer_ref": { "type": "string" },
    "properties": { "type": "object" }
  }
}
